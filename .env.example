# Example environment variables for cloudspartanx (names and placeholders only).
# The configuration loader does NOT read .env files; export these in your shell
# or process environment if you need them. Never commit a real secret.

# Selects the configuration environment: dev | test | experiment | staging.
CSX_ENV=dev

# Configuration keys use CSX__<AREA>__<KEY>. A secret is supplied only as a
# reference of the form env:NAME; the secret value itself goes only in the
# process environment, under NAME, and never in any file in this repository.
# Secret variable names must not start with CSX_ (reserved by the loader).
# CSX__LLM__API_KEY_REF=env:DAIL_LLM_API_KEY
